MATCH (n) RETURN count(*), min(id(n)), max(id(n))
  [[Integer(137), Integer(0), Integer(150)]]
MATCH ()-[r]->() RETURN count(*), min(id(r)), max(id(r))
  [[Integer(71), Integer(0), Integer(93)]]
MATCH (p:Person {name: 'person 17'}) RETURN id(p), p.age
  [[Integer(17), Integer(37)]]
MATCH (p:Person) WHERE p.age >= 30 AND p.age < 33 RETURN p.name, p.age ORDER BY p.name
  [[String("person 10"), Integer(30)], [String("person 11"), Integer(31)], [String("person 12"), Integer(32)], [String("person 50"), Integer(30)], [String("person 51"), Integer(31)], [String("person 52"), Integer(32)], [String("person 60"), Integer(30)], [String("person 62"), Integer(32)]]
MATCH (p:Person) WHERE p.age IN [20, 44, 59] RETURN count(*), sum(p.age)
  [[Integer(4), Integer(143)]]
MATCH ()-[k:KNOWS]->() WHERE k.since > 2015 RETURN count(*), sum(k.since)
  [[Integer(5), Integer(10110)]]
