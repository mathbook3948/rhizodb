MATCH (n:Item {i: 42}) RETURN id(n), n.text
  []
MATCH (n:Item) WHERE n.i >= 100 AND n.i < 110 RETURN id(n), n.i ORDER BY id(n)
  [[Integer(101), Integer(100)], [Integer(102), Integer(101)], [Integer(103), Integer(102)], [Integer(104), Integer(103)], [Integer(105), Integer(104)], [Integer(107), Integer(106)], [Integer(108), Integer(107)], [Integer(109), Integer(108)], [Integer(110), Integer(109)]]
MATCH (n:Item) WHERE n.i > 100 RETURN count(n), sum(n.i)
  [[Integer(172), Integer(34514)]]
MATCH (n:Five) RETURN labels(n), keys(n) ORDER BY id(n) LIMIT 3
  [[List([String("Item"), String("Five")]), List([String("i"), String("text"), String("vec")])], [List([String("Item"), String("Five")]), List([String("i"), String("text"), String("vec")])], [List([String("Item"), String("Five")]), List([String("i"), String("text"), String("vec")])]]
MATCH (:Person {name: 'Ada'})-[k:KNOWS {since: 1833}]->(b) RETURN b, k
  [[Node(Node { id: NodeId(1), labels: {"Person"}, properties: {"age": Integer(79), "name": String("Charles")} }), Relationship(Relationship { id: RelationshipId(0), rel_type: "KNOWS", start: NodeId(0), end: NodeId(1), properties: {"since": Integer(1833)} })]]
MATCH ()-[k:KNOWS]->() WHERE k.since >= 1800 RETURN k.since
  [[Integer(1833)]]
MATCH p = (:Item)-[:NEXT*1..3]->(:Item) RETURN count(p)
  [[Integer(516)]]
